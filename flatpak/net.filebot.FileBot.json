{
    "app-id": "net.filebot.FileBot",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "23.08",
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.openjdk21"
    ],
    "command": "filebot",
    "finish-args": [
        "--share=ipc",
        "--socket=x11",
        "--socket=wayland",
        "--share=network",
        "--filesystem=host",
        "--filesystem=home",
        "--device=dri",
        "--env=PATH=/app/bin:/app/jdk/bin:/usr/bin"
    ],
    "modules": [
        {
            "name": "openjdk",
            "buildsystem": "simple",
            "build-commands": [
                "/usr/lib/sdk/openjdk21/install.sh"
            ]
        },
        {
            "name": "filebot",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm755 flatpak/filebot.sh /app/bin/filebot",
                "install -Dm644 build/libs/filebot.jar /app/share/filebot/filebot.jar",
                "install -Dm644 flatpak/net.filebot.FileBot.desktop /app/share/applications/net.filebot.FileBot.desktop",
                "install -Dm644 flatpak/net.filebot.FileBot.metainfo.xml /app/share/metainfo/net.filebot.FileBot.metainfo.xml",
                "install -Dm644 flatpak/icons/net.filebot.FileBot.svg /app/share/icons/hicolor/scalable/apps/net.filebot.FileBot.svg",
                "for size in 16 24 32 48 64 72 128 256 512; do install -Dm644 flatpak/icons/net.filebot.FileBot_${size}x${size}.png /app/share/icons/hicolor/${size}x${size}/apps/net.filebot.FileBot.png; done"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
